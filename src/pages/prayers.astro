---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoHead from '../components/SeoHead.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export const prerender = true;

const pageTitle = 'Prayers — Kerygma Academy';
const pageDescription = 'Original prayers written for everyday moments and sacred seasons.';
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : new URL('https://kerygma.academy/prayers/');
type PrayerEntry = CollectionEntry<'prayers'>;
type PrayerRender = Awaited<ReturnType<PrayerEntry['render']>>;
type Prayer = {
  slug: PrayerEntry['slug'];
  data: PrayerEntry['data'];
  Content: PrayerRender['Content'];
};

const prayers: Prayer[] = await Promise.all(
  (await getCollection('prayers'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => {
      const { Content } = await entry.render();
      return {
        slug: entry.slug,
        data: entry.data,
        Content,
      };
    }),
);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SeoHead slot="head" title={pageTitle} description={pageDescription} url={pageUrl.href} />
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    href="/prayers.xml"
    title="Prayers feed"
  />
  <section class="page-hero prayers-hero surface surface--tinted">
    <span class="page-hero__halo" aria-hidden="true"></span>
    <span class="page-hero__sparkle" aria-hidden="true"></span>
    <span class="page-hero__sparkle" aria-hidden="true"></span>
    <div class="page-hero__content prayers-hero__content">
      <p class="kicker">Prayerbook</p>
      <h1>Supplications for the journey</h1>
      <p class="lead">
        Prayer is where I return to breathe again. These pieces are written for real people walking through real life&mdash;
        gratitude, grief, celebration, and quiet perseverance. Use them as you will: quietly, aloud, or in the company of those
        you shepherd.
      </p>
      <div class="page-hero__meta">
        <span class="meta-chip"><Icon name="seedling" aria-hidden="true" /> Growth</span>
        <span class="meta-chip"><Icon name="people-carry" aria-hidden="true" /> Community</span>
        <span class="meta-chip"><Icon name="church" aria-hidden="true" /> Worship</span>
      </div>
    </div>
  </section>

  <section class="prayer-list page-section">
    {prayers.map(({ slug, data, Content }) => (
      <article class="surface prayer-card">
        <header class="prayer-card__header">
          <div class="accent-divider" aria-hidden="true"></div>
          <h2>
            <a class="prayer-card__link" href={`/prayers/${slug}/`}>
              {data.title}
            </a>
            <button
              type="button"
              class="prayer-card__permalink"
              data-url={`/prayers/${slug}/`}
              data-status-id={`copy-status-${slug}`}
              aria-label={`Copy link to ${data.title}`}
            >
              <span aria-hidden="true">#</span>
            </button>
            <span
              id={`copy-status-${slug}`}
              class="visually-hidden"
              role="status"
              aria-live="polite"
            ></span>
          </h2>
          <p class="subtitle">{data.subtitle}</p>
          {data.tags.length > 0 && (
            <div class="prayer-card__meta">
              {data.tags.map((tag) => (
                <span class="floating-badge">
                  <Icon name={tag.icon} aria-hidden="true" />
                  {tag.label}
                </span>
              ))}
            </div>
          )}
        </header>
        <div class="prayer-text">
          <Content />
        </div>
      </article>
    ))}

    <aside class="surface surface--tinted prayers__notes">
      <h2>How to pray with these words</h2>
      <ul class="glow-list">
        <li>Pause before and after to listen for the Spirit&rsquo;s gentle promptings.</li>
        <li>Personalise a line or two with the names and needs of your community.</li>
        <li>Close with gratitude for how God is already at work among you.</li>
      </ul>
    </aside>
  </section>
</BaseLayout>

<style>
  .prayers-hero {
    overflow: hidden;
  }

  .prayers-hero__content {
    display: grid;
    gap: clamp(1.2rem, 2.4vw, 1.85rem);
  }

  .prayer-list {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.25rem);
  }

  .prayer-card {
    display: grid;
    gap: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .prayer-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 18%, rgba(138, 90, 60, 0.14), transparent 60%),
      radial-gradient(circle at 82% 80%, rgba(188, 209, 202, 0.1), transparent 58%);
    opacity: 0.55;
    pointer-events: none;
  }

  .prayer-card > * {
    position: relative;
    z-index: 1;
  }

  .prayer-card__header {
    display: grid;
    gap: 0.75rem;
  }

  .prayer-card__header h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .prayer-card__link {
    color: inherit;
    text-decoration: none;
  }

  .prayer-card__link:hover,
  .prayer-card__link:focus-visible {
    text-decoration: underline;
  }

  .prayer-card__permalink {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    font-size: 0.85rem;
    color: rgba(36, 28, 21, 0.58);
    text-decoration: none;
    background: transparent;
    border: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease, opacity 0.2s ease;
    opacity: 0;
    cursor: pointer;
  }

  .prayer-card:hover .prayer-card__permalink,
  .prayer-card:focus-within .prayer-card__permalink {
    opacity: 1;
    color: rgba(36, 28, 21, 0.75);
    background-color: rgba(188, 209, 202, 0.22);
    border-color: rgba(138, 90, 60, 0.28);
  }

  .prayer-card__permalink:focus-visible {
    outline: none;
    border-color: rgba(138, 90, 60, 0.4);
    background-color: rgba(138, 90, 60, 0.1);
    color: var(--accent-dark);
    opacity: 1;
  }

  @media (hover: none) {
    .prayer-card__permalink {
      opacity: 1;
      background-color: rgba(188, 209, 202, 0.24);
      border-color: rgba(138, 90, 60, 0.22);
    }

    .prayer-card__permalink:active {
      background-color: rgba(138, 90, 60, 0.18);
      border-color: rgba(138, 90, 60, 0.32);
      color: rgba(36, 28, 21, 0.85);
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .prayer-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .prayer-text p {
    color: rgba(36, 28, 21, 0.82);
  }

  .prayers__notes {
    display: grid;
    gap: 1rem;
  }
</style>

<script is:inline>
  const INIT_ATTR = 'data-copy-listener';
  const statusTimeouts = new Map();
  const clickHandlers = new WeakMap();

  const makeAbsoluteUrl = (path) => {
    if (!path) {
      return window.location.href;
    }

    try {
      return new URL(path, window.location.origin).toString();
    } catch {
      const origin = window.location.origin.replace(/\/$/, '');
      const normalisedPath = path.startsWith('/') ? path : `/${path}`;
      return `${origin}${normalisedPath}`;
    }
  };

  const setStatusMessage = (statusId, message) => {
    if (!statusId) return;
    const statusEl = document.getElementById(statusId);
    if (!statusEl) return;
    statusEl.textContent = message;
  };

  const clearStatusMessage = (statusId) => {
    if (!statusId) return;
    const statusEl = document.getElementById(statusId);
    if (statusEl) {
      statusEl.textContent = '';
    }
  };

  const scheduleStatusReset = (statusId, timeout = 4000) => {
    if (!statusId) return;
    const existingTimeout = statusTimeouts.get(statusId);
    if (typeof existingTimeout === 'number') {
      window.clearTimeout(existingTimeout);
    }

    const timeoutId = window.setTimeout(() => {
      clearStatusMessage(statusId);
      statusTimeouts.delete(statusId);
    }, timeout);

    statusTimeouts.set(statusId, timeoutId);
  };

  const handleClickFactory = (button) => async () => {
    const targetPath = button.dataset.url;
    const statusId = button.dataset.statusId || null;

    if (!targetPath) {
      setStatusMessage(statusId, 'Link unavailable.');
      scheduleStatusReset(statusId);
      return;
    }

    const targetUrl = makeAbsoluteUrl(targetPath);

    if (!navigator.clipboard) {
      setStatusMessage(statusId, 'Clipboard unavailable. Opening prayer detail page.');
      window.location.href = targetPath;
      scheduleStatusReset(statusId);
      return;
    }

    try {
      await navigator.clipboard.writeText(targetUrl);
      setStatusMessage(statusId, 'Link copied to clipboard.');
    } catch (error) {
      setStatusMessage(statusId, 'Unable to copy link. Opening prayer detail page for manual copy.');
      window.location.href = targetPath;
    }

    scheduleStatusReset(statusId);
  };

  const init = () => {
    const buttons = document.querySelectorAll('.prayer-card__permalink');
    buttons.forEach((button) => {
      if (button.getAttribute(INIT_ATTR) === 'true') return;
      const handler = handleClickFactory(button);
      button.addEventListener('click', handler);
      clickHandlers.set(button, handler);
      button.setAttribute(INIT_ATTR, 'true');
    });
  };

  const onDomContentLoaded = () => {
    init();
  };

  const onAstroAfterSwap = () => {
    init();
  };

  const removeLifecycleListeners = () => {
    document.removeEventListener('DOMContentLoaded', onDomContentLoaded);
    document.removeEventListener('astro:after-swap', onAstroAfterSwap);
  };

  const cleanup = () => {
    document
      .querySelectorAll(`.prayer-card__permalink[${INIT_ATTR}="true"]`)
      .forEach((button) => {
        const handler = clickHandlers.get(button);
        if (handler) {
          button.removeEventListener('click', handler);
          clickHandlers.delete(button);
        }
        button.removeAttribute(INIT_ATTR);
      });

    statusTimeouts.forEach((timeoutId, statusId) => {
      window.clearTimeout(timeoutId);
      clearStatusMessage(statusId);
    });
    statusTimeouts.clear();

    removeLifecycleListeners();
  };

  if (document.readyState !== 'loading') {
    init();
  }

  document.addEventListener('DOMContentLoaded', onDomContentLoaded);
  document.addEventListener('astro:after-swap', onAstroAfterSwap);
  document.addEventListener('astro:before-swap', cleanup);
</script>
