---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoHead from '../components/SeoHead.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects.ts';

export const prerender = true;

const pageTitle = 'Portfolio — Kerygma Academy';
const pageDescription = 'Selected ministry, technology, and creative projects.';
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : new URL('https://kerygma.academy/portfolio/');


const buildImageUrl = (asset: ImageMetadata) => (Astro.site ? new URL(asset.src, Astro.site).href : asset.src);
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: projects.map((project, index) => {
    const outboundLinks = [project.primaryLink?.href, project.secondaryLink?.href].filter(Boolean);
    return {
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'CreativeWork',
        name: project.name,
        description: project.description,
        image: buildImageUrl(project.image.asset),
        url: outboundLinks[0],
        sameAs: outboundLinks,
      },
    };
  }),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SeoHead slot="head" title={pageTitle} description={pageDescription} url={pageUrl.href} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(itemListJsonLd)}></script>
  <section class="page-hero portfolio-hero surface surface--tinted">
    <span class="page-hero__halo" aria-hidden="true"></span>
    <span class="page-hero__sparkle" aria-hidden="true"></span>
    <span class="page-hero__sparkle" aria-hidden="true"></span>
    <div class="page-hero__content portfolio-hero__content">
      <p class="kicker">Portfolio</p>
      <h1>Projects at the intersection of faith &amp; design</h1>
      <p class="lead">
        A sampling of the projects that have shaped my journey. From ministry initiatives to digital products, each reflects a
        commitment to prayerful discernment, thoughtful design, and hospitable user experience.
      </p>
      <div class="page-hero__meta">
        <span class="meta-chip"><Icon name="chart-column" aria-hidden="true" /> Analytics</span>
        <span class="meta-chip"><Icon name="pen-nib" aria-hidden="true" /> Design</span>
        <span class="meta-chip"><Icon name="hands-holding" aria-hidden="true" /> Ministry</span>
      </div>
    </div>
  </section>

  <section class="projects page-section">
    {projects.map((project) => (
      <article class="surface project-card">
        <header class="project-card__header">
          <div class="accent-divider" aria-hidden="true"></div>
          <h2>{project.name}</h2>
          <p class="subtitle">{project.subtitle}</p>
          <div class="project-card__meta">
            {project.badges.map((badge) => (
              <span class="floating-badge">
                <Icon name={badge.icon} aria-hidden="true" />
                {badge.label}
              </span>
            ))}
          </div>
        </header>
        <figure class="project-card__media">
          <Image
            src={project.image.asset}
            width={project.image.asset.width}
            height={project.image.asset.height}
            alt={project.image.alt}
            sizes={project.image.sizes}
            loading="lazy"
          />
        </figure>
        <p>{project.description}</p>
        <h3>Highlights</h3>
        <ul class="project-card__list glow-list">
          {project.highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
        <div class="project-links">
          <a class="button" href={project.primaryLink.href} target="_blank" rel="noopener noreferrer">
            {project.primaryLink.label}
          </a>
          {project.secondaryLink && (
            <a class="button secondary" href={project.secondaryLink.href} target="_blank" rel="noopener noreferrer">
              {project.secondaryLink.label}
            </a>
          )}
        </div>
      </article>
    ))}
    <aside class="surface surface--tinted projects__notes">
      <h2>How I approach collaborations</h2>
      <ul class="glow-list">
        <li>Begin with prayer and clarity about the people we aim to serve.</li>
        <li>Prototype quickly, invite feedback, and iterate with pastoral sensitivity.</li>
        <li>Deliver tools that feel beautiful, resilient, and rooted in Gospel hope.</li>
      </ul>
    </aside>
  </section>
</BaseLayout>

<style>
  .portfolio-hero {
    overflow: hidden;
  }

  .portfolio-hero__content {
    display: grid;
    gap: clamp(1.2rem, 2.4vw, 1.85rem);
  }

  .projects {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.25rem);
  }

  .project-card {
    display: grid;
    gap: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 18%, rgba(138, 90, 60, 0.12), transparent 65%),
      radial-gradient(circle at 78% 82%, rgba(188, 209, 202, 0.1), transparent 60%);
    opacity: 0.55;
    pointer-events: none;
  }

  .project-card > * {
    position: relative;
    z-index: 1;
  }

  .project-card__header {
    display: grid;
    gap: 0.75rem;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-card__list {
    margin: 0;
  }

  .project-card__media {
    border-radius: 0.85rem;
    border: 1px solid rgba(36, 28, 21, 0.08);
    overflow: hidden;
    box-shadow: 0 18px 42px -24px rgba(36, 28, 21, 0.4);
  }

  .project-card__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .projects__notes {
    display: grid;
    gap: 1rem;
  }
</style>
