---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoHead from '../components/SeoHead.astro';

export const prerender = true;

const pageTitle = 'Page Not Found — Kerygma Academy';
const pageDescription = 'We could not find the page you were looking for, but here are a few places to begin again.';
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : new URL('https://kerygma.academy/404');
Astro.response.status = 404;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SeoHead slot="head" title={pageTitle} description={pageDescription} url={pageUrl.href} />
  <section class="error surface surface--tinted">
    <span class="error__sparkle" aria-hidden="true"></span>
    <span class="error__sparkle" aria-hidden="true"></span>
    <div class="error__content">
      <p class="kicker">404</p>
      <h1>The page you seek has wandered off.</h1>
      <p>
        Let&#39;s guide you back to familiar rooms filled with poetry, creative work, and paths for study. Choose a destination
        below to continue your visit.
      </p>
      <nav aria-label="Popular destinations" class="error__nav">
        <a class="button" href="/">Return home</a>
        <a class="button button--secondary" href="/poetry">Read poetry</a>
        <a class="button button--secondary" href="/courses">Browse courses</a>
        <a class="button button--secondary" href="/portfolio">Visit the portfolio</a>
        <a class="button button--secondary" href="/contact">Get in touch</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .error {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 5rem);
  }

  .error__content {
    max-width: 48rem;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .error__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .error__sparkle {
    position: absolute;
    width: clamp(14rem, 36vw, 20rem);
    height: clamp(14rem, 36vw, 20rem);
    background: radial-gradient(circle, rgba(255, 255, 255, 0.75) 0%, rgba(255, 255, 255, 0) 70%);
    opacity: 0.6;
    filter: blur(0.5px);
  }

  .error__sparkle:first-of-type {
    top: -5rem;
    left: -4rem;
  }

  .error__sparkle:last-of-type {
    bottom: -6rem;
    right: -5rem;
  }

  @media (max-width: 600px) {
    .error {
      padding: clamp(2rem, 6vw, 3rem);
    }

    .error__nav {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
