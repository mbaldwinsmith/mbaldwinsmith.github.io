---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoHead from '../components/SeoHead.astro';

export const prerender = true;

const pageTitle = 'Courses — Kerygma Academy';
const pageDescription =
  'Free Catholic formation courses curated across apologetics, doctrine, Scripture, philosophy, and more.';
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : new URL('https://kerygma.academy/courses/');

const slugifyCategory = (value: string) =>
  value
    .toString()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');

