---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoHead from '../components/SeoHead.astro';
import Icon from '../components/Icon.astro';
import { courseSections as courseSectionsData } from '../data/courses.ts';
import {
  evaluateCourseGroups as evaluateCourseGroupsHelper,
  matchesSearch as matchesSearchHelper,
  normalizeCategory as normalizeCategoryHelper,
  normalizeSearchTerm as normalizeSearchTermHelper,
} from '../utils/courseFilters.ts';

export const prerender = true;

const pageTitle = 'Courses — Kerygma Academy';
const pageDescription =
  'Free Catholic formation courses curated across apologetics, doctrine, Scripture, philosophy, and more.';
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : new URL('https://kerygma.academy/courses/');

const normalizeCategorySource = normalizeCategoryHelper.toString();
const normalizeSearchTermSource = normalizeSearchTermHelper.toString();
const matchesSearchSource = matchesSearchHelper.toString();
const evaluateCourseGroupsSource = evaluateCourseGroupsHelper.toString();
const courseFiltersScript = String.raw`
  const courseFiltersState =
    window.__courseFiltersState ?? (window.__courseFiltersState = {});

  if (typeof courseFiltersState.afterSwapListener === 'function') {
    document.removeEventListener('astro:after-swap', courseFiltersState.afterSwapListener);
  }

  const normalizeCategory = ${normalizeCategorySource};
  const normalizeSearchTerm = ${normalizeSearchTermSource};
  const matchesSearch = ${matchesSearchSource};
  const evaluateCourseGroups = ${evaluateCourseGroupsSource};

  /** @type {(() => void) | null} */
  let destroyCourseFilters = null;

  const initCourseFilters = () => {
    const filterForm = document.querySelector('[data-course-filters]');
    if (!(filterForm instanceof HTMLFormElement) || filterForm.dataset.enhanced === 'true') {
      return;
    }

    const searchInput = filterForm.querySelector('[data-filter-search]');
    const categorySelect = filterForm.querySelector('[data-filter-category]');
    const visibleCountEl = filterForm.querySelector('[data-course-visible-count]');
    const resultsLabel = filterForm.querySelector('[data-course-results-label]');
    const emptyMessage = document.querySelector('[data-course-empty]');

    /** @type {Array<{ element: HTMLElement; category: string; items: Array<{ element: HTMLElement; text: string }> }>} */
    const filterGroups = [];

    document.querySelectorAll('[data-course-group]').forEach((groupElement) => {
      if (!(groupElement instanceof HTMLElement)) {
        return;
      }

      const items = Array.from(groupElement.querySelectorAll('[data-course-item]'))
        .filter((item) => item instanceof HTMLElement)
        .map((itemElement) => ({
          element: /** @type {HTMLElement} */ (itemElement),
          text: itemElement.textContent ?? '',
        }));

      filterGroups.push({
        element: groupElement,
        category: normalizeCategory(groupElement.dataset.category),
        items,
      });
    });

    const dataGroups = filterGroups.map(({ category, items }) => ({
      category,
      items: items.map(({ text }) => ({ text })),
    }));

    const updateFilters = () => {
      const searchTerm = searchInput instanceof HTMLInputElement ? searchInput.value : '';
      const selectedCategory =
        categorySelect instanceof HTMLSelectElement ? categorySelect.value : 'all';

      filterGroups.forEach((group, groupIndex) => {
        group.items.forEach((item, itemIndex) => {
          dataGroups[groupIndex].items[itemIndex].text = item.element.textContent ?? '';
        });
      });

      const { totalVisible, groups: results } = evaluateCourseGroups(
        dataGroups,
        searchTerm,
        selectedCategory,
      );

      results.forEach((groupResult, groupIndex) => {
        const { element, items } = filterGroups[groupIndex];

        groupResult.itemVisibilities.forEach((isVisible, itemIndex) => {
          const itemElement = items[itemIndex].element;
          itemElement.hidden = !isVisible;
        });

        if (groupResult.matchesCategory && groupResult.visibleCount > 0) {
          element.removeAttribute('hidden');
          element.style.removeProperty('display');
          element.removeAttribute('aria-hidden');
        } else {
          element.setAttribute('hidden', '');
          element.style.display = 'none';
          element.setAttribute('aria-hidden', 'true');
        }
      });

      if (visibleCountEl instanceof HTMLElement) {
        visibleCountEl.textContent = String(totalVisible);
      }

      if (resultsLabel instanceof HTMLElement) {
        resultsLabel.textContent = totalVisible === 1 ? 'course' : 'courses';
      }

      if (emptyMessage instanceof HTMLElement) {
        emptyMessage.toggleAttribute('hidden', totalVisible !== 0);
      }
    };

    const handleSubmit = (event) => {
      event.preventDefault();
    };

    const handleInput = (event) => {
      if (event.target === searchInput) {
        updateFilters();
      }
    };

    const handleCategoryChange = () => {
      updateFilters();
    };

    filterForm.addEventListener('submit', handleSubmit);
    filterForm.addEventListener('input', handleInput);

    if (categorySelect instanceof HTMLSelectElement) {
      categorySelect.addEventListener('change', handleCategoryChange);
    }

    filterForm.dataset.enhanced = 'true';

    destroyCourseFilters = () => {
      filterForm.removeEventListener('submit', handleSubmit);
      filterForm.removeEventListener('input', handleInput);

      if (categorySelect instanceof HTMLSelectElement) {
        categorySelect.removeEventListener('change', handleCategoryChange);
      }

      document.removeEventListener('astro:after-swap', initCourseFilters);

      filterForm.removeAttribute('data-enhanced');
      destroyCourseFilters = null;
      courseFiltersState.afterSwapListener = null;
    };

    updateFilters();
  };

  document.addEventListener('astro:before-swap', () => {
    destroyCourseFilters?.();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCourseFilters, { once: true });
  } else {
    initCourseFilters();
  }

  document.addEventListener('astro:after-swap', initCourseFilters);
  courseFiltersState.afterSwapListener = initCourseFilters;
`;

const slugifyCategory = (value: string) =>
  value
    .toString()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');

const courseSections = courseSectionsData.map((section) => ({
  ...section,
  slug: slugifyCategory(section.title),
}));

const totalCourses = courseSections.reduce(
  (total, section) => total + section.items.length,
  0
);

const courseListElements = courseSections.reduce(
  (list, section) => {
    section.items.forEach((course) => {
      list.push({
        '@type': 'ListItem',
        position: list.length + 1,
        item: {
          '@type': 'Course',
          name: course.title,
          url: course.url,
          isPartOf: {
            '@type': 'CreativeWorkSeries',
            name: section.title,
            '@id': `${pageUrl.href}#${section.slug}`,
          },
        },
      });
    });

    return list;
  },
  [] as Array<Record<string, unknown>>
);

const coursesJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: pageTitle,
  url: pageUrl.href,
  numberOfItems: totalCourses,
  itemListElement: courseListElements,
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SeoHead slot="head" title={pageTitle} description={pageDescription} url={pageUrl.href} />
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(coursesJsonLd)}></script>
  <section class="page-hero courses-hero surface surface--tinted">
    <span class="page-hero__halo" aria-hidden="true"></span>
    <span class="page-hero__sparkle" aria-hidden="true"></span>
    <span class="page-hero__sparkle" aria-hidden="true"></span>
    <div class="page-hero__content courses-hero__content">
      <p class="kicker">Courses</p>
      <h1>Free Catholic Courses</h1>
      <p class="lead">
        Explore a curated library of trusted, no-cost Catholic formation courses spanning theology, Scripture, philosophy,
        and pastoral practice. Every selection invites deeper discipleship for seekers, catechists, and ministry leaders.
      </p>
      <div class="page-hero__meta">
        <span class="meta-chip"><Icon name="book-open" aria-hidden="true" /> Formation</span>
        <span class="meta-chip"><Icon name="lightbulb" aria-hidden="true" /> Study</span>
        <span class="meta-chip"><Icon name="people-group" aria-hidden="true" /> Community</span>
      </div>
    </div>
  </section>

  <section class="courses page-section">
    <article class="surface surface--tinted courses__intro">
      <h2>Curated pathways for formation</h2>
      <p>
        These courses are freely available through trusted Catholic institutes and apostolates. Use them to spark parish
        study groups, personal retreats, or ongoing catechetical formation.
      </p>
    </article>

    <form
      class="surface surface--tinted course-filters"
      data-course-filters
      role="search"
      aria-labelledby="course-filters-title"
    >
      <h2 id="course-filters-title" class="sr-only">Search and filter courses</h2>
      <div class="filter-field">
        <label class="filter-label" for="course-search">Search courses</label>
        <input
          class="filter-input"
          id="course-search"
          type="search"
          name="search"
          placeholder="Search by course title"
          autocomplete="off"
          data-filter-search
        />
      </div>
      <div class="filter-field">
        <label class="filter-label" for="course-category">Filter by category</label>
        <select class="filter-input" id="course-category" name="category" data-filter-category>
          <option value="all">All categories</option>
          {courseSections.map((section) => (
            <option value={section.slug}>{section.title}</option>
          ))}
        </select>
      </div>
      <p class="course-results" data-course-results aria-live="polite">
        Showing
        <strong><span data-course-visible-count>{totalCourses}</span></strong>
        <span data-course-results-label>{totalCourses === 1 ? 'course' : 'courses'}</span>
      </p>
    </form>

    <p class="course-empty" data-course-empty hidden>
      No courses match your filters. Try adjusting your search or choosing a different category.
    </p>

    <div class="courses__grid">
      {courseSections.map((section) => (
        <section class="surface course-group" data-course-group data-category={section.slug}>
          <header>
            <h3>{section.title}</h3>
          </header>
          <ul>
            {section.items.map((item) => (
              <li data-course-item>
                <a href={item.url} rel="noopener noreferrer" target="_blank">
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="compiled-note">Compiled October 2025</p>
  </section>
</BaseLayout>

<script is:inline set:html={courseFiltersScript}></script>

<style>
  .courses-hero {
    overflow: hidden;
  }

  .courses-hero__content {
    display: grid;
    gap: clamp(1.2rem, 2.5vw, 1.9rem);
  }

  .courses {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.25rem);
  }

  .courses__intro {
    display: grid;
    gap: 0.85rem;
    border: 1px solid rgba(92, 73, 58, 0.16);
  }

  .course-filters {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid rgba(92, 73, 58, 0.16);
    padding: clamp(1.2rem, 3vw, 1.8rem);
  }

  .course-filters .filter-field {
    display: grid;
    gap: 0.45rem;
  }

  .filter-label {
    font-weight: 600;
    color: rgba(36, 28, 21, 0.76);
  }

  .filter-input {
    font: inherit;
    padding: 0.65rem 0.85rem;
    border-radius: 0.65rem;
    border: 1px solid rgba(92, 73, 58, 0.25);
    background: rgba(255, 255, 255, 0.72);
    color: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .filter-input:focus {
    outline: none;
    border-color: rgba(138, 90, 60, 0.55);
    box-shadow: 0 0 0 3px rgba(138, 90, 60, 0.18);
  }

  .course-results {
    margin: 0;
    font-size: 0.95rem;
    color: rgba(36, 28, 21, 0.62);
  }

  .course-results strong {
    color: var(--accent-dark);
    font-weight: 600;
  }

  .course-empty {
    margin: 0;
    padding: 0.85rem 1.1rem;
    border-radius: 0.75rem;
    border: 1px dashed rgba(138, 90, 60, 0.45);
    background: rgba(138, 90, 60, 0.08);
    color: rgba(36, 28, 21, 0.7);
    font-weight: 500;
    text-align: center;
  }

  @media (min-width: 640px) {
    .course-filters {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
      align-items: end;
    }

    .course-filters .course-results {
      grid-column: 1 / -1;
      justify-self: end;
    }
  }

  .courses__grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (min-width: 720px) {
    .courses__grid {
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    }
  }

  .course-group {
    display: grid;
    gap: 1rem;
    border: 1px solid rgba(92, 73, 58, 0.18);
  }

  .course-group header h3 {
    margin: 0;
  }

  .course-group ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.2rem;
  }

  .course-group a {
    color: var(--accent-dark);
    border-bottom: 1px solid rgba(138, 90, 60, 0.25);
    padding-bottom: 0.1em;
  }

  .compiled-note {
    font-style: italic;
    color: rgba(36, 28, 21, 0.65);
    justify-self: end;
  }
</style>
