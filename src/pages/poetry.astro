---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoHead from '../components/SeoHead.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const pageTitle = 'Poetry — Kerygma Academy';
const pageDescription = 'Poems capturing the movement of faith, community, and everyday beauty.';
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : new URL('https://kerygma.academy/poetry/');
type Poem = {
  id: string;
  title: string;
  stanzas: string[][];
};

const poemEntries = await getCollection('poetry');
const poems: Poem[] = poemEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ slug, data }) => ({
    id: slug,
    title: data.title,
    stanzas: data.stanzas,
  }));

const escapeHTML = (value: string): string =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
const stanzaToHtml = (lines: string[]): string => lines.map(escapeHTML).join('<br />');
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SeoHead slot="head" title={pageTitle} description={pageDescription} url={pageUrl.href} />
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    href="/poetry.xml"
    title="Poetry feed"
  />
  <script type="application/ld+json" is:inline>
    {JSON.stringify(
      (() => {
        const authorName = 'Mark Baldwin-Smith';
        return {
          '@context': 'https://schema.org',
          '@type': 'ItemList',
          name: 'Poetry Collection by Mark Baldwin-Smith',
          description: pageDescription,
          url: pageUrl.href,
          numberOfItems: poems.length,
          itemListElement: poems.map((poem, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            url: `${pageUrl.href}#${poem.id}`,
            item: {
              '@type': 'Poem',
              name: poem.title,
              text: poem.stanzas.map((lines) => lines.join('\n')).join('\n\n'),
              author: {
                '@type': 'Person',
                name: authorName,
              },
              isPartOf: {
                '@type': 'WebPage',
                name: pageTitle,
                url: pageUrl.href,
              },
            },
          })),
        };
      })(),
      null,
      2,
    )}
  </script>
  <section class="page-hero poetry-hero surface surface--tinted">
    <span class="page-hero__halo" aria-hidden="true"></span>
    <span class="page-hero__sparkle" aria-hidden="true"></span>
    <span class="page-hero__sparkle" aria-hidden="true"></span>
    <div class="page-hero__content poetry-hero__content">
      <p class="kicker">Poetry</p>
      <h1>Verses for Pilgrims and Prophets</h1>
      <p class="lead">
        I write poems as a practice of listening. They are fragments of prayer, memory, and imagination gathered together to make
        meaning. Read them aloud, meditate on the images, and let the cadence steady your breath.
      </p>
      <div class="page-hero__meta">
        <span class="meta-chip"><Icon name="dove" aria-hidden="true" /> Prayer</span>
        <span class="meta-chip"><Icon name="leaf" aria-hidden="true" /> Creation</span>
        <span class="meta-chip"><Icon name="fire" aria-hidden="true" /> Devotion</span>
      </div>
    </div>
  </section>

  <section class="poems page-section">
    <div class="poems__grid">
      <nav class="surface surface--frosted poems__toc" aria-label="Poem navigation">
        <div class="poems__toc-header">
          <h2 class="poems__toc-title" id="poems-toc-heading">Poems</h2>
          <button
            class="poems__toc-toggle"
            type="button"
            aria-expanded="true"
            aria-controls="poems-toc-list"
            aria-labelledby="poems-toc-toggle-label poems-toc-heading"
            hidden
          >
            <span id="poems-toc-toggle-label" class="poems__toc-toggle-text">Contents</span>
            <Icon name="chevron-down" aria-hidden="true" />
          </button>
        </div>
        <ul class="poems__toc-list" id="poems-toc-list">
          {poems.map((poem) => (
            <li>
              <a class="poems__toc-link" href={`#${poem.id}`}>
                {poem.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="surface surface--frosted poems__audio">
        <div class="poems__audio-copy">
          <p class="kicker">Listen while you linger</p>
          <h2 class="poems__audio-title">The Golden Thread</h2>
          <p>
            Each poem has a musical companion. Let the playlist drift through the room while you read, pray, or ponder the images
            in the verses below.
          </p>
          <p class="poems__audio-credit">
            Written and composed by
            <a href="https://soundcloud.com/mark-baldwin-smith" target="_blank" rel="noopener noreferrer">Mark Baldwin-Smith</a>,
            performed by
            <a href="https://suno.com/@plato2paraclete" target="_blank" rel="noopener noreferrer">Suno</a>.
          </p>
        </div>
        <div class="poems__audio-player">
          <iframe
            loading="lazy"
            referrerpolicy="no-referrer"
            title="SoundCloud playlist: The Golden Thread"
            src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/playlists/2095234155&color=%23e2b140&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true"
          ></iframe>
          <a class="poems__audio-link" href="https://soundcloud.com/mark-baldwin-smith/sets/the-golden-thread" target="_blank" rel="noopener noreferrer">
            Listen on SoundCloud
            <Icon name="arrow-up-right-from-square" aria-hidden="true" />
          </a>
        </div>
      </div>
      {poems.map((poem) => (
        <article class="surface poem-card">
          <header class="poem-card__header">
            <div class="accent-divider" aria-hidden="true"></div>
            <h2 class="poem-card__title" id={poem.id}>
              {poem.title}
              <a class="poem-card__permalink" href={`/poetry/${poem.id}/`} aria-label={`Open full page for ${poem.title}`}>
                <span aria-hidden="true">#</span>
              </a>
            </h2>
          </header>
          <div class="poem">
            {poem.stanzas.map((lines) => (
              <p set:html={stanzaToHtml(lines)}></p>
            ))}
          </div>
        </article>
      ))}
    </div>

  </section>
</BaseLayout>

<script is:inline>
  const initPoemsToc = () => {
    const toc = document.querySelector('.poems__toc');
    if (!toc || toc.dataset.enhanced === 'true') {
      return;
    }

    const list = toc.querySelector('.poems__toc-list');
    const toggle = toc.querySelector('.poems__toc-toggle');
    if (!list || !toggle) {
      return;
    }

    toc.dataset.enhanced = 'true';

    const sentinel = document.createElement('span');
    sentinel.className = 'poems__toc-sentinel';
    sentinel.setAttribute('aria-hidden', 'true');
    toc.parentElement?.insertBefore(sentinel, toc);

    const mobileQuery = window.matchMedia('(max-width: 1199px)');
    let isMobileActive = false;
    let userExpanded = false;
    let stickyThreshold = 0;
    let scrollFrame = null;
    let activeFrame = null;
    let activeLink = null;

    const updateStickyThreshold = () => {
      stickyThreshold = sentinel.getBoundingClientRect().top + window.scrollY;
    };

    const tocLinks = Array.from(list.querySelectorAll('.poems__toc-link'));
    const sectionTargets = tocLinks
      .map((link) => {
        const href = link.getAttribute('href') || '';
        if (!href.startsWith('#')) {
          return null;
        }

        const targetId = decodeURIComponent(href.slice(1));
        const heading = document.getElementById(targetId);
        if (!heading) {
          return null;
        }

        return { link, heading };
      })
      .filter(Boolean);

    const setActiveLink = (nextLink) => {
      if (activeLink === nextLink) {
        return;
      }

      if (activeLink) {
        activeLink.classList.remove('is-active');
        activeLink.removeAttribute('aria-current');
      }

      activeLink = nextLink || null;

      if (activeLink) {
        activeLink.classList.add('is-active');
        activeLink.setAttribute('aria-current', 'true');
      }
    };

    const syncActiveLink = () => {
      activeFrame = null;
      if (!sectionTargets.length) {
        return;
      }

      const targetLine = window.innerHeight * 0.25;
      let closest = null;
      let closestDistance = Infinity;

      sectionTargets.forEach(({ link, heading }) => {
        const rect = heading.getBoundingClientRect();
        const distance = Math.abs(rect.top - targetLine);
        if (distance < closestDistance) {
          closest = link;
          closestDistance = distance;
        }
      });

      if (closest) {
        setActiveLink(closest);
      }
    };

    const scheduleActiveSync = () => {
      if (activeFrame !== null) {
        return;
      }

      activeFrame = window.requestAnimationFrame(syncActiveLink);
    };

    const syncCollapsedState = () => {
      if (!isMobileActive) {
        return;
      }

      if (window.scrollY > stickyThreshold) {
        collapse();
      } else {
        expand();
      }
    };

    const scheduleSync = () => {
      if (scrollFrame !== null) {
        return;
      }

      scrollFrame = window.requestAnimationFrame(() => {
        scrollFrame = null;
        syncCollapsedState();
      });
    };

    const handleScroll = () => {
      if (!isMobileActive) {
        return;
      }

      scheduleSync();
    };

    const handleActiveScroll = () => {
      scheduleActiveSync();
    };

    const handleResize = () => {
      if (isMobileActive) {
        updateStickyThreshold();
        syncCollapsedState();
      }

      scheduleActiveSync();
    };

    const setExpanded = (expanded, { fromUser = false } = {}) => {
      if (fromUser) {
        userExpanded = expanded;
      }

      toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');

      if (isMobileActive) {
        toc.classList.toggle('poems__toc--open', expanded);
        if (expanded) {
          list.removeAttribute('hidden');
        } else {
          list.setAttribute('hidden', '');
        }
      } else {
        list.removeAttribute('hidden');
      }
    };

    const collapse = () => {
      if (!isMobileActive) {
        return;
      }

      toc.classList.add('poems__toc--collapsed');
      if (!userExpanded) {
        setExpanded(false);
      }
    };

    const expand = () => {
      if (!isMobileActive) {
        return;
      }

      toc.classList.remove('poems__toc--collapsed');
      userExpanded = false;
      setExpanded(true);
    };

    const enableMobile = () => {
      isMobileActive = true;
      toggle.hidden = false;
      userExpanded = false;
      toc.classList.remove('poems__toc--collapsed');
      setExpanded(true);
      updateStickyThreshold();

      window.addEventListener('scroll', handleScroll, { passive: true });

      requestAnimationFrame(() => {
        updateStickyThreshold();
        syncCollapsedState();
      });
    };

    const disableMobile = () => {
      isMobileActive = false;
      toggle.hidden = true;
      userExpanded = false;
      toc.classList.remove('poems__toc--collapsed', 'poems__toc--open');
      setExpanded(true);
      window.removeEventListener('scroll', handleScroll);
      if (scrollFrame !== null) {
        window.cancelAnimationFrame(scrollFrame);
        scrollFrame = null;
      }
    };

    const onToggleClick = () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      setExpanded(!expanded, { fromUser: true });
    };

    toggle.addEventListener('click', onToggleClick);

    const handleMediaChange = (event) => {
      if (event.matches) {
        enableMobile();
      } else {
        disableMobile();
      }
    };

    let detachMediaQueryListener = null;
    if (typeof mobileQuery.addEventListener === 'function') {
      mobileQuery.addEventListener('change', handleMediaChange);
      detachMediaQueryListener = () => {
        mobileQuery.removeEventListener('change', handleMediaChange);
      };
    } else if (typeof mobileQuery.addListener === 'function') {
      mobileQuery.addListener(handleMediaChange);
      detachMediaQueryListener = () => {
        mobileQuery.removeListener(handleMediaChange);
      };
    }

    if (sectionTargets.length) {
      window.addEventListener('scroll', handleActiveScroll, { passive: true });
      window.addEventListener('resize', handleResize);
      scheduleActiveSync();
    } else {
      window.addEventListener('resize', handleResize);
    }

    if (mobileQuery.matches) {
      enableMobile();
    } else {
      disableMobile();
    }

    document.addEventListener(
      'astro:before-swap',
      () => {
        toggle.removeEventListener('click', onToggleClick);
        if (detachMediaQueryListener) {
          detachMediaQueryListener();
          detachMediaQueryListener = null;
        }
        window.removeEventListener('scroll', handleScroll);
        window.removeEventListener('scroll', handleActiveScroll);
        window.removeEventListener('resize', handleResize);
        if (scrollFrame !== null) {
          window.cancelAnimationFrame(scrollFrame);
          scrollFrame = null;
        }
        if (activeFrame !== null) {
          window.cancelAnimationFrame(activeFrame);
          activeFrame = null;
        }
      },
      { once: true },
    );
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPoemsToc, { once: true });
  } else {
    initPoemsToc();
  }

  document.addEventListener('astro:after-swap', initPoemsToc);
</script>

<style>
  .poetry-hero {
    overflow: hidden;
  }

  .poetry-hero__content {
    display: grid;
    gap: clamp(1.2rem, 2.5vw, 1.9rem);
  }

  .poems,
  .poems__grid {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.5rem);
  }

  .poems__toc {
    display: grid;
    gap: 1rem;
    padding: clamp(1.4rem, 3vw, 1.9rem);
    border-radius: 1.1rem;
    align-self: start;
  }

  .poems__toc-sentinel {
    display: block;
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  .poems__toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .poems__toc-title {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 1.95rem);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .poems__toc-toggle {
    border: 1px solid rgba(28, 89, 66, 0.25);
    background: rgba(255, 255, 255, 0.85);
    color: #1c5942;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .poems__toc-toggle:focus-visible {
    outline: 3px solid rgba(18, 69, 47, 0.35);
    outline-offset: 2px;
  }

  .poems__toc-toggle:hover {
    background: rgba(255, 255, 255, 0.95);
  }

  .poems__toc-toggle i {
    font-size: 0.9rem;
    transition: transform 0.2s ease;
  }

  .poems__toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .poems__toc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: #1c5942;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .poems__toc-link::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: rgba(28, 89, 66, 0.35);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .poems__toc-link.is-active,
  .poems__toc-link[aria-current='true'] {
    color: #12452f;
    font-weight: 700;
    text-decoration: none;
  }

  .poems__toc-link.is-active::before,
  .poems__toc-link[aria-current='true']::before {
    background: #e2b140;
    transform: scale(1.15);
    box-shadow: 0 0 0 3px rgba(226, 177, 64, 0.28);
  }

  .poems__toc-link:hover,
  .poems__toc-link:focus-visible {
    color: #12452f;
  }

  .poems__toc-link:hover::before,
  .poems__toc-link:focus-visible::before {
    background: #1c5942;
    transform: scale(1.15);
  }

  .poems__toc:not(.poems__toc--open) .poems__toc-toggle i {
    transform: rotate(-90deg);
  }

  .poems__audio {
    display: grid;
    gap: clamp(1.8rem, 3vw, 2.4rem);
    padding: clamp(1.8rem, 4vw, 2.8rem);
    border-radius: 1.2rem;
    position: relative;
    overflow: hidden;
  }

  .poems__audio::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(226, 177, 64, 0.18), rgba(88, 130, 104, 0.2));
    opacity: 0.9;
    z-index: 0;
  }

  .poems__audio-copy,
  .poems__audio-player {
    position: relative;
    z-index: 1;
  }

  .poems__audio-player {
    display: grid;
    gap: 0.75rem;
  }

  .poems__audio-player iframe {
    width: 100%;
    min-height: 280px;
    border: none;
    border-radius: 0.9rem;
  }

  .poems__audio-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    align-self: start;
  }

  .poem-card {
    position: relative;
    padding: clamp(2rem, 4vw, 2.6rem);
    border-radius: 1.2rem;
    display: grid;
    gap: clamp(1.6rem, 3vw, 2rem);
  }

  .poem-card__header {
    display: grid;
    gap: 1rem;
  }

  .accent-divider {
    width: 4rem;
    height: 0.35rem;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(226, 177, 64, 0.9), rgba(88, 130, 104, 0.95));
  }

  .poem-card__title {
    margin: 0;
    font-size: clamp(1.9rem, 3.5vw, 2.4rem);
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
  }

  .poem-card__permalink {
    font-size: 1.1rem;
    color: rgba(36, 28, 21, 0.6);
    border: none;
    padding: 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .poem-card__title:hover .poem-card__permalink,
  .poem-card__title:focus-within .poem-card__permalink {
    opacity: 1;
  }

  .poem {
    display: grid;
    gap: 1.2rem;
    font-size: 1.05rem;
  }

  .poem strong {
    font-weight: 700;
  }

  .poems__notes {
    padding: clamp(1.8rem, 3.6vw, 2.4rem);
    border-radius: 1.2rem;
    display: grid;
    gap: 1rem;
  }

  .glow-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .glow-list li {
    position: relative;
    padding-left: 1.6rem;
  }

  .glow-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(226, 177, 64, 0.8), rgba(226, 177, 64, 0));
  }

  @media (min-width: 1200px) {
    .poems__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
      align-items: start;
    }

    .poems__toc {
      position: sticky;
      top: calc(var(--site-header-height, 0px) + clamp(1.5rem, 5vw, 2.8rem));
      grid-column: 1 / 2;
    }

    .poems__toc-toggle {
      display: none;
    }

    .poems__toc-sentinel {
      grid-column: 1 / -1;
    }

    .poems__audio {
      grid-column: 2 / -1;
      align-self: start;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
    }

    .poem-card {
      grid-column: 2 / -1;
    }

  }

  @media (max-width: 599px) {
    .poems__audio-player iframe {
      min-height: 240px;
    }
  }

  @media (max-width: 1199px) {
    .poems__toc {
      gap: 0.75rem;
    }

    .poems__toc-title {
      font-size: clamp(1.4rem, 5vw, 1.75rem);
    }

    .poems__toc-toggle {
      display: inline-flex;
    }

    .poems__toc--collapsed:not(.poems__toc--open) {
      padding: 0.95rem 1.2rem;
      gap: 0.35rem;
      box-shadow: 0 18px 30px -24px rgba(36, 28, 21, 0.4);
    }

    .poems__toc--collapsed:not(.poems__toc--open) .poems__toc-title {
      font-size: 1.35rem;
      margin-bottom: 0;
    }

    .poems__toc--collapsed:not(.poems__toc--open) .poems__toc-list {
      display: none;
    }

    .poems__toc--collapsed:not(.poems__toc--open) .poems__toc-toggle {
      padding: 0.35rem 0.7rem;
      font-size: 0.9rem;
    }
  }
</style>
