---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoHead from '../../components/SeoHead.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { cleanMarkdownToPlainText } from '../../utils/cleanMarkdown.js';

export const prerender = true;

export async function getStaticPaths() {
  const prayers = await getCollection('prayers');
  return prayers.map((prayer) => ({
    params: { slug: prayer.slug },
    props: { prayer },
  }));
}

const { prayer } = Astro.props as { prayer: CollectionEntry<'prayers'> };
const { Content } = await prayer.render();
const pageTitle = `${prayer.data.title} — Prayers — Kerygma Academy`;
const cleanedBodyText = cleanMarkdownToPlainText(prayer.body);
const openingSentences = cleanedBodyText.match(/[^.!?]+[.!?]+/g) || [];
const derivedDescription = openingSentences.length
  ? openingSentences.slice(0, 2).join(' ').trim()
  : cleanedBodyText;
const pageDescription =
  (prayer.data.summary && prayer.data.summary.trim()) ||
  derivedDescription ||
  `A prayer from Kerygma Academy: ${prayer.data.title}.`;
const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : new URL(`https://kerygma.academy/prayers/${prayer.slug}/`);
const formattedDate = prayer.data.date
  ? prayer.data.date.toLocaleDateString('en-US', { dateStyle: 'long' })
  : null;
---

<BaseLayout title={pageTitle} description={pageDescription} ogType="article">
  <SeoHead slot="head" title={pageTitle} description={pageDescription} url={pageUrl.href} />
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    href="/prayers.xml"
    title="Prayers feed"
  />
  {prayer && (
    <script type="application/ld+json" is:inline>
      {JSON.stringify(
        (() => {
          const schemaType = prayer.data.date ? 'Article' : 'CreativeWork';
          const authorName = 'Mark Baldwin-Smith';
          const publisherName = 'Kerygma Academy';
          const maxArticleBodyLength = 2000;
          const trimmedBodyText = cleanedBodyText.trim();
          const articleBodyContent =
            trimmedBodyText.length > maxArticleBodyLength
              ? `${trimmedBodyText.slice(0, maxArticleBodyLength - 1).trimEnd()}…`
              : trimmedBodyText;
          const jsonLd: Record<string, unknown> = {
            '@context': 'https://schema.org',
            '@type': schemaType,
            headline: prayer.data.title,
            name: prayer.data.title,
            alternativeHeadline: prayer.data.subtitle,
            url: pageUrl.href,
          };
          jsonLd.author = {
            '@type': 'Person',
            name: authorName,
          };
          jsonLd.publisher = {
            '@type': 'Organization',
            name: publisherName,
          };
          if (prayer.data.summary) {
            jsonLd.description = prayer.data.summary;
          }
          if (prayer.data.date) {
            jsonLd.datePublished = prayer.data.date.toISOString().split('T')[0];
          }
          if (prayer.data.tags?.length) {
            jsonLd.keywords = prayer.data.tags.map((tag) => tag.label);
          }
          if (articleBodyContent) {
            if (schemaType === 'Article') {
              jsonLd.articleBody = articleBodyContent;
            } else {
              jsonLd.text = articleBodyContent;
            }
          }
          return jsonLd;
        })(),
        null,
        2,
      )}
    </script>
  )}
  <article
    class="surface prayer-detail"
    data-prayer-title={prayer.data.title}
    data-prayer-slug={prayer.slug}
  >
    <header class="prayer-detail__header">
      <div class="accent-divider" aria-hidden="true"></div>
      <h1>{prayer.data.title}</h1>
      <p class="prayer-detail__subtitle">{prayer.data.subtitle}</p>
      {prayer.data.summary && <p class="prayer-detail__summary">{prayer.data.summary}</p>}
      {(formattedDate || prayer.data.tags.length > 0) && (
        <div class="prayer-detail__meta">
          {formattedDate && <p class="prayer-detail__date">Published {formattedDate}</p>}
          {prayer.data.tags.length > 0 && (
            <div class="prayer-detail__tags">
              {prayer.data.tags.map((tag) => (
                <span class="floating-badge">
                  <Icon name={tag.icon} aria-hidden="true" />
                  {tag.label}
                </span>
              ))}
            </div>
          )}
        </div>
      )}
    </header>
    <div class="prayer-detail__body">
      <Content />
    </div>
    <footer class="prayer-detail__footer">
      <div
        class="prayer-detail__actions"
        data-prayer-actions
        role="group"
        aria-label="Prayer utilities"
      >
        <button type="button" class="button prayer-detail__action" data-action="print">
          <Icon name="print" aria-hidden="true" />
          Print
        </button>
        <button type="button" class="button prayer-detail__action" data-action="download">
          <Icon name="file-arrow-down" aria-hidden="true" />
          Download PDF
        </button>
      </div>
      <a class="prayer-detail__back" href="/prayers/">
        <Icon name="arrow-left" aria-hidden="true" />
        Back to all prayers
      </a>
    </footer>
  </article>
</BaseLayout>

<script type="module" is:inline>
  const initPrayerUtilities = () => {
    const actions = document.querySelector('[data-prayer-actions]');
    if (!actions) return;

    const article = actions.closest('.prayer-detail');
    const body = article?.querySelector('.prayer-detail__body');
    if (!article || !body) return;

    const prayerTitle = article.getAttribute('data-prayer-title') ?? 'Prayer';
    const prayerSlug = article.getAttribute('data-prayer-slug') ?? 'prayer';

    const textEncoder = new TextEncoder();

    const normaliseForPdf = (input) =>
      input
        .replace(/[\u2013\u2014]/g, '--')
        .replace(/[\u2018\u2019]/g, "'")
        .replace(/[\u201C\u201D]/g, '"')
        .replace(/[•·]/g, '*')
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^\x20-\x7E]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

    const escapePdfText = (text) =>
      text.replace(/\\/g, '\\\\').replace(/\(/g, '\\(').replace(/\)/g, '\\)');

    const wrapText = (text, width = 84) => {
      if (!text) return [];
      const words = text.split(/\s+/).filter(Boolean);
      if (words.length === 0) return [];
      const lines = [];
      let currentLine = words.shift() ?? '';
      if (!currentLine) return lines;
      for (const word of words) {
        if (`${currentLine} ${word}`.length > width) {
          lines.push(currentLine);
          currentLine = word;
        } else {
          currentLine = `${currentLine} ${word}`;
        }
      }
      lines.push(currentLine);
      return lines;
    };

    const extractBlocks = (root) => {
      const blocks = [];
      const selector = 'h2, h3, h4, h5, h6, p, li, blockquote';
      root.querySelectorAll(selector).forEach((node) => {
        const rawText = node.textContent?.replace(/\s+/g, ' ').trim();
        if (!rawText) return;
        const prefix = node.tagName === 'LI' ? '* ' : '';
        blocks.push(`${prefix}${rawText}`);
        if (
          node.tagName === 'P' ||
          node.tagName === 'BLOCKQUOTE' ||
          node.tagName.startsWith('H')
        ) {
          blocks.push('');
        }
      });

      while (blocks.length && blocks[blocks.length - 1] === '') {
        blocks.pop();
      }

      return blocks;
    };

    const chunkLines = (lines, size) => {
      const pages = [];
      for (let index = 0; index < lines.length; index += size) {
        pages.push(lines.slice(index, index + size));
      }
      return pages.length > 0 ? pages : [[' ']];
    };

    const buildContentObject = (objectNumber, pageLines) => {
      const contentLines = ['BT', '/F1 12 Tf', '14 TL', '1 0 0 1 72 720 Tm'];
      pageLines.forEach((line, lineIndex) => {
        const safeLine = line.trim() ? line : ' ';
        const text = escapePdfText(safeLine);
        if (lineIndex === 0) {
          contentLines.push(`(${text}) Tj`);
        } else {
          contentLines.push('T*');
          contentLines.push(`(${text}) Tj`);
        }
      });
      contentLines.push('ET');
      const content = contentLines.join('\n');
      const length = textEncoder.encode(content).length;
      return `${objectNumber} 0 obj << /Length ${length} >> stream\n${content}\nendstream\nendobj`;
    };

    const createPdfBlob = (rawBlocks, title) => {
      const lines = [];
      rawBlocks.forEach((block) => {
        if (!block) {
          lines.push(' ');
          return;
        }
        const normalised = normaliseForPdf(block);
        if (!normalised) return;
        wrapText(normalised).forEach((line) => lines.push(line));
      });

      if (lines.length === 0) {
        lines.push(' ');
      }

      const pages = chunkLines(lines, 46);
      const pageCount = pages.length;
      const kids = pages
        .map((_, index) => `${3 + index} 0 R`)
        .join(' ');

      let pdf = '%PDF-1.4\n';
      const offsets = [];
      const addObject = (content) => {
        offsets.push(textEncoder.encode(pdf).length);
        pdf += `${content}\n`;
      };

      addObject('1 0 obj << /Type /Catalog /Pages 2 0 R >> endobj');
      addObject(
        `2 0 obj << /Type /Pages /Kids [${kids}] /Count ${pageCount} /MediaBox [0 0 612 792] >> endobj`,
      );

      const fontObjectNumber = 3 + pageCount;
      const contentStartNumber = fontObjectNumber + 1;

      pages.forEach((_, index) => {
        const pageObjectNumber = 3 + index;
        const contentObjectNumber = contentStartNumber + index;
        addObject(
          `${pageObjectNumber} 0 obj << /Type /Page /Parent 2 0 R /Resources << /Font << /F1 ${fontObjectNumber} 0 R >> >> /Contents ${contentObjectNumber} 0 R >> endobj`,
        );
      });

      addObject(
        `${fontObjectNumber} 0 obj << /Type /Font /Subtype /Type1 /Name /F1 /BaseFont /Times-Roman >> endobj`,
      );

      pages.forEach((pageLines, index) => {
        const contentObjectNumber = contentStartNumber + index;
        addObject(buildContentObject(contentObjectNumber, pageLines));
      });

      const infoObjectNumber = contentStartNumber + pageCount;
      const normalisedTitle = normaliseForPdf(title) || 'Prayer';
      const infoTitle = escapePdfText(normalisedTitle);
      addObject(
        `${infoObjectNumber} 0 obj << /Title (${infoTitle}) /Producer (Kerygma Academy Prayer Toolkit) >> endobj`,
      );

      const xrefOffset = textEncoder.encode(pdf).length;
      const totalObjects = offsets.length;
      pdf += `xref\n0 ${totalObjects + 1}\n`;
      pdf += '0000000000 65535 f \n';
      offsets.forEach((offset) => {
        pdf += `${offset.toString().padStart(10, '0')} 00000 n \n`;
      });
      pdf += `trailer << /Size ${totalObjects + 1} /Root 1 0 R /Info ${infoObjectNumber} 0 R >>\n`;
      pdf += `startxref\n${xrefOffset}\n%%EOF`;

      return new Blob([pdf], { type: 'application/pdf' });
    };

    actions.addEventListener('click', (event) => {
      const target =
        event.target instanceof Element
          ? event.target.closest('button[data-action]')
          : null;
      if (!(target instanceof HTMLButtonElement)) return;

      const action = target.getAttribute('data-action');
      if (action === 'print') {
        window.print();
        return;
      }

      if (action === 'download') {
        if (target.disabled) return;
        target.disabled = true;
        target.setAttribute('aria-busy', 'true');
        try {
          const blocks = extractBlocks(body);
          const pdfBlob = createPdfBlob(blocks, prayerTitle);
          const fileName = `${
            prayerSlug
              .toLowerCase()
              .replace(/[^a-z0-9-]+/g, '-')
              .replace(/-{2,}/g, '-')
              .replace(/^-|-$/g, '') || 'prayer'
          }.pdf`;
          const url = URL.createObjectURL(pdfBlob);
          const link = document.createElement('a');
          link.href = url;
          link.download = fileName;
          document.body.appendChild(link);
          link.click();
          link.remove();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
        } catch (error) {
          console.error('Unable to generate PDF', error);
          alert('Sorry, the PDF could not be generated. Please try printing instead.');
        } finally {
          target.disabled = false;
          target.removeAttribute('aria-busy');
          target.focus();
        }
      }
    });
  };

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPrayerUtilities, { once: true });
    } else {
      initPrayerUtilities();
    }
  }
</script>

<style>
  .prayer-detail {
    display: grid;
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3rem);
    position: relative;
    overflow: hidden;
  }

  .prayer-detail::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 18%, rgba(138, 90, 60, 0.14), transparent 60%),
      radial-gradient(circle at 82% 80%, rgba(188, 209, 202, 0.1), transparent 58%);
    opacity: 0.55;
    pointer-events: none;
  }

  .prayer-detail > * {
    position: relative;
    z-index: 1;
  }

  .prayer-detail__header {
    display: grid;
    gap: 0.75rem;
  }

  .prayer-detail__subtitle {
    font-size: 1.05rem;
    color: rgba(36, 28, 21, 0.72);
  }

  .prayer-detail__summary {
    font-size: 1rem;
    color: rgba(36, 28, 21, 0.72);
  }

  .prayer-detail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .prayer-detail__date {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(36, 28, 21, 0.66);
  }

  .prayer-detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .prayer-detail__body {
    display: grid;
    gap: 1.25rem;
  }

  .prayer-detail__body :global(p) {
    margin: 0;
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    line-height: 1.85;
    color: rgba(36, 28, 21, 0.82);
    font-family: 'Source Serif 4', Georgia, 'Times New Roman', serif;
  }

  .prayer-detail__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
  }

  .prayer-detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .prayer-detail__action {
    min-height: 2.5rem;
  }

  .prayer-detail__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Libre Franklin', 'Source Serif 4', serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--accent-dark);
    text-decoration: none;
  }

  .prayer-detail__back:hover,
  .prayer-detail__back:focus-visible {
    text-decoration: underline;
  }

  @page {
    margin: 1in;
  }

  @media (max-width: 600px) {
    .prayer-detail__footer {
      flex-direction: column;
      align-items: stretch;
    }

    .prayer-detail__actions {
      justify-content: center;
    }

    .prayer-detail__back {
      justify-content: center;
    }
  }

  @media print {
    :global(body) {
      background: #fff !important;
      color: #000 !important;
      box-shadow: none;
    }

    :global(body)::before {
      display: none !important;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .prayer-detail__footer {
      display: none !important;
    }

    :global(main.page) {
      padding: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }

    .prayer-detail {
      padding: 0;
      margin: 0;
      background: transparent;
      box-shadow: none;
    }

    .prayer-detail::before {
      display: none;
    }

    .prayer-detail__header,
    .prayer-detail__body {
      color: #000;
    }

    .prayer-detail__body :global(p) {
      font-size: 12pt;
      color: #000;
    }

    .prayer-detail__body :global(a) {
      color: inherit;
      text-decoration: none;
    }

    .accent-divider {
      display: none;
    }
  }
</style>
