---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoHead from '../../components/SeoHead.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const poems = await getCollection('poetry');
  return poems.map((poem) => ({
    params: { slug: poem.slug },
    props: { poem },
  }));
}

const { poem } = Astro.props as { poem: CollectionEntry<'poetry'> };
const pageTitle = `${poem.data.title} — Poetry — Kerygma Academy`;
const pageDescription = `A poem from Kerygma Academy: ${poem.data.title}.`;
const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : new URL(`https://kerygma.academy/poetry/${poem.slug}/`);
const stanzaToHtml = (lines: string[]): string =>
  lines
    .map((line) =>
      line
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;'),
    )
    .join('<br />');
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SeoHead slot="head" title={pageTitle} description={pageDescription} url={pageUrl.href} />
  <article class="surface poem-detail">
    <header class="poem-detail__header">
      <div class="accent-divider" aria-hidden="true"></div>
      <h1>{poem.data.title}</h1>
      <p class="poem-detail__meta">Published {poem.data.date.toLocaleDateString('en-US', { dateStyle: 'long' })}</p>
    </header>
    <div class="poem-detail__body">
      {poem.data.stanzas.map((lines) => (
        <p set:html={stanzaToHtml(lines)}></p>
      ))}
    </div>
    <footer class="poem-detail__footer">
      <a class="poem-detail__back" href="/poetry/">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Back to all poems
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .poem-detail {
    display: grid;
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3rem);
    position: relative;
    overflow: hidden;
  }

  .poem-detail::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 18%, rgba(138, 90, 60, 0.14), transparent 60%),
      radial-gradient(circle at 82% 80%, rgba(188, 209, 202, 0.1), transparent 58%);
    opacity: 0.55;
    pointer-events: none;
  }

  .poem-detail > * {
    position: relative;
    z-index: 1;
  }

  .poem-detail__header {
    display: grid;
    gap: 0.75rem;
  }

  .poem-detail__meta {
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(36, 28, 21, 0.66);
  }

  .poem-detail__body {
    display: grid;
    gap: 1.25rem;
  }

  .poem-detail__body p {
    margin: 0;
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    line-height: 1.85;
    font-family: 'Source Serif 4', Georgia, 'Times New Roman', serif;
  }

  .poem-detail__footer {
    display: flex;
    justify-content: flex-start;
  }

  .poem-detail__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Libre Franklin', 'Source Serif 4', serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--accent-dark);
    text-decoration: none;
  }

  .poem-detail__back:hover,
  .poem-detail__back:focus-visible {
    text-decoration: underline;
  }
</style>
