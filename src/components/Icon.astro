---
import type { IconName } from '../data/icons';
import { iconMap } from './iconMap';

const props = Astro.props as {
  name: IconName;
  class?: string;
  title?: string;
  [key: string]: any;
};

const { name, title, class: className, ...rest } = props;
const icon = iconMap[name];

if (!icon) {
  throw new Error(`Icon \"${name}\" is not defined in Icon.astro`);
}

const { ['aria-hidden']: ariaHiddenProp, ...svgRest } = rest;
const ariaHidden = ariaHiddenProp ?? (title ? undefined : 'true');
const role = ariaHidden === 'true' || ariaHidden === true ? undefined : 'img';
const [width, height, , , svgPathData] = icon.icon;
const paths = Array.isArray(svgPathData) ? svgPathData : [svgPathData];
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${width} ${height}`}
  class={['icon', className].filter(Boolean).join(' ')}
  role={role}
  aria-hidden={ariaHidden}
  aria-label={ariaHidden ? undefined : title}
  focusable="false"
  {...svgRest}
>
  {title && !ariaHidden && <title>{title}</title>}
  {paths.map((d) => (
    <path d={d} fill="currentColor" />
  ))}
</svg>
